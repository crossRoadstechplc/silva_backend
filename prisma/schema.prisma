generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  silva
  spx
  vendor
}

enum TenantStatus {
  active
  suspended
  pending
}

enum RegistrationRequestStatus {
  submitted
  under_review
  approved
  rejected
}

enum ContactSubmissionStatus {
  new
  read
}

enum ProgramStatus {
  active
  archived
}

enum ProgramMemberRole {
  owner
  manager
  executor
  viewer
}

enum AfeBand {
  A
  B
  C
  D
}

enum AfpStatus {
  draft
  submitted
  approved
  active
  closed
}

enum AfeStatus {
  draft
  submitted
  validated
  approved
  active
  closed
  rejected
}

enum WorkOrderStatus {
  draft
  issued
  in_progress
  complete
  closed
}

enum WorkOrderTier {
  retainer
  project
  special
}

enum TaskStatus {
  draft
  open
  in_progress
  complete
  cancelled
}

enum FieldTicketStatus {
  draft
  submitted
  vendor_reviewed
  validated
  rejected
}

enum FieldTicketType {
  field_execution
  payroll_confirmation
}

enum WorkPlanSubmissionStatus {
  draft
  submitted
  revision_requested
  accepted
  rejected
}

enum FarmEstateStatus {
  active
  inactive
}

enum IfsFormType {
  daily_work_log
  pruning_completion
  fertilizer_application
  pest_disease_scout
  harvest_cherry_intake
  safety_stop_work
  equipment_downtime
  weather_field_readiness
  labor_attendance
  block_inspection
}

enum IfsFormStatus {
  draft
  submitted
  validated
  rejected
}

enum SeasonCalendarStatus {
  draft
  active
  archived
}

enum SeasonWindowStatus {
  planned
  issued
  in_progress
  complete
  cancelled
}

enum PaymentRequestStatus {
  draft
  submitted
  verified
  rejected
  settled
}

enum PaymentRequestType {
  bagro_fee
  reimbursable_cost
  vendor_fee
}

enum SettlementStatus {
  draft
  authorized
  settled
}

enum SettlementType {
  bagro_fee
  labor_wages
  vendor_payment
}

enum VendorStatus {
  active
  pending
  expired
  terminated
}

enum ProcurementRoute {
  sole_source
  competitive_tender
}

enum TenderStatus {
  n_a
  in_progress
  awarded
}

enum RevenueTier {
  retainer
  project
  special
}

enum InvoicePaymentStatus {
  invoiced
  paid
  overdue
}

enum ReportType {
  weekly
  monthly
  quarterly
  annual
}

enum ReportStatus {
  draft
  in_review
  released
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

enum GlExportStatus {
  pending
  ready
  failed
}

model organizations {
  id                        String           @id
  name                      String
  slug                      String           @unique
  displayName               String
  type                      OrganizationType
  brandingJson              Json?
  status                    TenantStatus     @default(active)
  isDefaultExecutionPartner Boolean          @default(false)
  active                    Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  users                     users[]
  memberships               organization_memberships[]
  invites                   invites[]
  vendor                    vendors?
  programsCreated           programs[]       @relation("ProgramCreator")
  programMemberships        program_memberships[]
  programInvitesSent        program_org_invites[] @relation("ProgramInviteFrom")
  programInvitesReceived    program_org_invites[] @relation("ProgramInviteTo")
  registrationRequests      registration_requests[]
  ownedFarmEstates          farm_estates[]        @relation("FarmEstateOwner")
}

model registration_requests {
  id                  String                    @id
  orgType             OrganizationType
  status              RegistrationRequestStatus @default(submitted)
  orgName             String
  orgSlug             String
  displayName         String?
  legalName           String?
  country             String?
  region              String?
  address             String?
  website             String?
  contactName         String
  contactEmail        String
  contactPhone        String?
  contactTitle        String?
  assetInterests      String?
  estimatedHectares   Decimal?                  @db.Decimal(12, 2)
  governanceNotes     String?
  vendorCategory      String?
  servicesProvided    String?
  insuranceOnFile     Boolean?
  fieldCapacity       String?
  profileJson         Json?
  reviewNotes         String?
  reviewedByUserId    String?
  reviewedAt          DateTime?
  provisionedOrgId    String?
  activationTokenHash String?
  activationExpiresAt DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  reviewedBy          users?                    @relation("RegistrationReviewer", fields: [reviewedByUserId], references: [id])
  provisionedOrg      organizations?            @relation(fields: [provisionedOrgId], references: [id])

  @@index([status])
  @@index([contactEmail])
  @@index([orgSlug])
}

model contact_submissions {
  id           String                  @id
  name         String
  email        String
  organization String?
  subject      String
  message      String
  status       ContactSubmissionStatus @default(new)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model programs {
  id              String        @id
  name            String
  slug            String        @unique
  status          ProgramStatus @default(active)
  brandingJson    Json?
  createdByOrgId  String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdByOrg    organizations @relation("ProgramCreator", fields: [createdByOrgId], references: [id])
  memberships     program_memberships[]
  orgInvites      program_org_invites[]
  usersActive     users[]       @relation("ActiveProgram")

  afpLines        afp_lines[]
  afes            afes[]
  workOrders      work_orders[]
  fieldTickets    field_tickets[]
  paymentRequests payment_requests[]
  settlements     owner_settlements[]
  revenueLedger   spx_revenue_ledger[]
  reports         reports[]
  notifications   notifications[]
  harvestKpis     harvest_kpi_snapshots[]
  auditLogs       audit_log[]
  ifsForms        ifs_forms[]
  seasonCalendars season_calendars[]
  seasonWindows   season_windows[]
  schedule3       schedule3_thresholds[]
  schedule4       schedule4_insurance[]
  accountability  accountability_matrix[]
  platformConfig  platform_config?
  disclosures     related_party_disclosures[]
  glExports       gl_journal_exports[]
  itemComments    item_comments[]
  activityCatalog activity_catalog[]
  activitySchedules activity_schedule[]
  afpLineSchedules afp_line_schedules[]
  workPlanSubmissions work_plan_submissions[]
  farmBlocks      farm_blocks[]
  farmEstates     farm_estates[]
}

model program_memberships {
  id             String            @id
  programId      String
  organizationId String
  roleInProgram  ProgramMemberRole @default(manager)
  createdAt      DateTime          @default(now())

  program        programs          @relation(fields: [programId], references: [id], onDelete: Cascade)
  organization   organizations     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([programId, organizationId])
  @@index([organizationId])
}

model program_org_invites {
  id                String       @id
  programId         String
  fromOrganizationId String
  toOrganizationId  String?
  toOrgSlug         String?
  toEmail           String?
  roleInProgram     ProgramMemberRole @default(executor)
  status            InviteStatus @default(pending)
  tokenHash         String       @unique
  expiresAt         DateTime
  createdAt         DateTime     @default(now())

  program           programs     @relation(fields: [programId], references: [id], onDelete: Cascade)
  fromOrganization  organizations @relation("ProgramInviteFrom", fields: [fromOrganizationId], references: [id])
  toOrganization    organizations? @relation("ProgramInviteTo", fields: [toOrganizationId], references: [id])
}

model users {
  id               String   @id
  name             String
  email            String   @unique
  passwordHash     String
  role             String
  organizationId   String
  vendorId         String?
  activeProgramId  String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     organizations @relation(fields: [organizationId], references: [id])
  vendor           vendors?      @relation(fields: [vendorId], references: [id])
  activeProgram    programs?     @relation("ActiveProgram", fields: [activeProgramId], references: [id])
  memberships      organization_memberships[]
  invitesSent      invites[]     @relation("InvitedBy")
  registrationReviews registration_requests[] @relation("RegistrationReviewer")
  refreshSessions  refresh_sessions[]
  notifications    notifications[]
  auditLogs        audit_log[]
  attachments      attachments[]
  assignedWos      work_order_assignments[]
  tasksAssigned    work_order_tasks[] @relation("TaskAssignee")
  tasksCreated     work_order_tasks[] @relation("TaskCreator")
  fieldTickets     field_tickets[]    @relation("TicketSubmitter")
  ticketsSigned    field_tickets[]    @relation("TicketSigner")
  paymentRequests  payment_requests[] @relation("PrRequester")
  prsVerified      payment_requests[] @relation("PrVerifier")
  settlementsAuth  owner_settlements[] @relation("SettlementAuthorizer")
  scorecards       vendor_scorecards[]
  reportsReleased  reports[]
  afpCreated       afp_lines[]
  afeCreated       afes[]
  ifsSubmitted     ifs_forms[] @relation("IfsSubmitter")
  ifsValidated     ifs_forms[] @relation("IfsValidator")
  itemComments     item_comments[]
  seasonCalendars  season_calendars[]
  workPlansSubmitted work_plan_submissions[] @relation("WorkPlanSubmitter")
  workPlansReviewed  work_plan_submissions[] @relation("WorkPlanReviewer")
  blockAssignments   work_order_block_assignments[] @relation("BlockManager")

  @@index([organizationId])
  @@index([role])
  @@index([activeProgramId])
}

model organization_memberships {
  id             String   @id
  userId         String
  organizationId String
  role           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  user           users         @relation(fields: [userId], references: [id])
  organization   organizations @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model invites {
  id              String       @id
  organizationId  String
  vendorId        String?
  email           String
  role            String
  status          InviteStatus @default(pending)
  tokenHash       String
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime     @default(now())

  organization    organizations @relation(fields: [organizationId], references: [id])
  invitedBy       users         @relation("InvitedBy", fields: [invitedByUserId], references: [id])
}

model refresh_sessions {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model password_reset_tokens {
  id        String   @id
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model restricted_export_credentials {
  id        String    @id
  name      String
  tokenHash String    @unique
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model vendors {
  id                        String       @id
  organizationId            String       @unique
  name                      String
  category                  String
  servicesProvided          String       @default("")
  prequalified              Boolean      @default(false)
  insuranceOnFile           Boolean      @default(false)
  insuranceExpiry           DateTime?
  status                    VendorStatus @default(pending)
  isDefaultExecutionPartner Boolean      @default(false)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  organization              organizations @relation(fields: [organizationId], references: [id])
  users                     users[]
  workOrders                work_orders[]
  contracts                 vendor_contracts[]
  scorecards                vendor_scorecards[]
  workPlanSubmissions       work_plan_submissions[]
  farmEstateVendors         farm_estate_vendors[]
}

model afp_lines {
  id                    String    @id
  programId             String
  year                  Int
  operatingDiscipline   String
  activity              String
  budgetAllocatedUsd    Decimal   @db.Decimal(14, 2)
  budgetAllocatedEtb    Decimal?  @db.Decimal(14, 2)
  kpiTarget             String
  status                AfpStatus @default(draft)
  silvaApproved         Boolean   @default(false)
  approvalDate          DateTime?
  notes                 String?
  workPlanSubmissionId  String?
  createdByUserId       String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  program               programs  @relation(fields: [programId], references: [id])
  createdBy             users     @relation(fields: [createdByUserId], references: [id])
  workPlanSubmission    work_plan_submissions? @relation(fields: [workPlanSubmissionId], references: [id])
  afes                  afes[]
  activityCatalog       activity_catalog[]
  lineSchedules         afp_line_schedules[]

  @@index([programId, year, status])
  @@index([workPlanSubmissionId])
}

model afes {
  id                    String    @id
  programId             String
  afpLineId             String
  operatingDiscipline   String
  description           String
  estimatedCostUsd      Decimal   @db.Decimal(14, 2)
  band                  AfeBand
  spxValidated          Boolean   @default(false)
  silvaApprovalRequired Boolean
  silvaApproved         Boolean?
  approvalDate          DateTime?
  status                AfeStatus @default(draft)
  createdByUserId       String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  program               programs  @relation(fields: [programId], references: [id])
  afp                   afp_lines @relation(fields: [afpLineId], references: [id])
  createdBy             users     @relation(fields: [createdByUserId], references: [id])
  workOrders            work_orders[]
  contracts             vendor_contracts[]

  @@index([programId, status, band])
}

model work_orders {
  id                  String          @id
  programId           String
  afeId               String
  category            String
  activity            String
  tier                WorkOrderTier
  weekStart           Int
  weekEnd             Int
  spxOversightHoursL1 Int             @default(0)
  spxOversightHoursL2 Int             @default(0)
  spxOversightHoursL3 Int             @default(0)
  assignedVendorId    String?
  activityCatalogId   String?
  status              WorkOrderStatus @default(draft)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  program             programs        @relation(fields: [programId], references: [id])
  afe                 afes            @relation(fields: [afeId], references: [id])
  assignedVendor      vendors?        @relation(fields: [assignedVendorId], references: [id])
  activityCatalog     activity_catalog? @relation(fields: [activityCatalogId], references: [id])
  assignments         work_order_assignments[]
  blockAssignments    work_order_block_assignments[]
  tasks               work_order_tasks[]
  fieldTickets        field_tickets[]
  paymentRequests     payment_requests[]
  settlements         owner_settlements[]
  ifsForms            ifs_forms[]
  seasonWindows       season_windows[]

  @@index([programId, status])
  @@index([activityCatalogId])
}

model work_order_assignments {
  id          String       @id
  workOrderId String
  userId      String
  roleOnOrder String
  isPrimary   Boolean      @default(false)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  workOrder   work_orders  @relation(fields: [workOrderId], references: [id])
  user        users        @relation(fields: [userId], references: [id])
}

model work_order_tasks {
  id              String      @id
  workOrderId     String
  title           String
  description     String      @default("")
  assigneeUserId  String?
  status          TaskStatus  @default(open)
  dueDate         DateTime?
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  workOrder       work_orders @relation(fields: [workOrderId], references: [id])
  assignee        users?      @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  createdBy       users       @relation("TaskCreator", fields: [createdByUserId], references: [id])
}

model field_tickets {
  id                 String            @id
  programId          String
  workOrderId        String
  submittedByUserId  String
  activityCatalogId  String?
  ticketType         FieldTicketType   @default(field_execution)
  activityRecorded   String
  areaHa             Decimal           @db.Decimal(10, 2)
  laborCount         Int
  materialsUsed      String            @default("")
  actualQuantity     Decimal?          @db.Decimal(14, 2)
  actualMandays      Decimal?          @db.Decimal(14, 2)
  actualCostEtb      Decimal?          @db.Decimal(14, 2)
  normValidationJson Json?
  ticketDate         DateTime
  signedOff          Boolean           @default(false)
  signedOffByUserId  String?
  signedOffAt        DateTime?
  status             FieldTicketStatus @default(draft)
  paymentRequestId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  program            programs          @relation(fields: [programId], references: [id])
  workOrder          work_orders       @relation(fields: [workOrderId], references: [id])
  activityCatalog    activity_catalog? @relation(fields: [activityCatalogId], references: [id])
  submittedBy        users             @relation("TicketSubmitter", fields: [submittedByUserId], references: [id])
  signedOffBy        users?            @relation("TicketSigner", fields: [signedOffByUserId], references: [id])
  paymentRequests    payment_requests[]
  ifsForms           ifs_forms[]

  @@index([programId, status])
  @@index([activityCatalogId])
}

model payment_requests {
  id                  String               @id
  programId           String
  workOrderId         String
  fieldTicketId       String
  requestedByUserId   String
  type                PaymentRequestType
  amountRequestedEtb  Decimal              @db.Decimal(14, 2)
  dateSubmitted       DateTime?
  spxVerified         Boolean              @default(false)
  spxVerifiedByUserId String?
  verifiedDate        DateTime?
  status              PaymentRequestStatus @default(draft)
  settlementId        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  program             programs             @relation(fields: [programId], references: [id])
  workOrder           work_orders          @relation(fields: [workOrderId], references: [id])
  fieldTicket         field_tickets        @relation(fields: [fieldTicketId], references: [id])
  requestedBy         users                @relation("PrRequester", fields: [requestedByUserId], references: [id])
  verifiedBy          users?               @relation("PrVerifier", fields: [spxVerifiedByUserId], references: [id])
  settlements         owner_settlements[]

  @@index([programId, status])
}

model owner_settlements {
  id                 String           @id
  programId          String
  workOrderId        String
  paymentRequestId   String
  type               SettlementType
  payee              String
  amountEtb          Decimal          @db.Decimal(14, 2)
  spxAuthorized      Boolean          @default(false)
  authorizedByUserId String?
  dateAuthorized     DateTime?
  status             SettlementStatus @default(draft)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  program            programs         @relation(fields: [programId], references: [id])
  workOrder          work_orders      @relation(fields: [workOrderId], references: [id])
  paymentRequest     payment_requests @relation(fields: [paymentRequestId], references: [id])
  authorizedBy       users?           @relation("SettlementAuthorizer", fields: [authorizedByUserId], references: [id])

  @@index([programId, status])
}

model vendor_contracts {
  id               String           @id
  vendorId         String
  afeId            String
  contractValueUsd Decimal          @db.Decimal(14, 2)
  procurementRoute ProcurementRoute
  tenderStatus     TenderStatus     @default(n_a)
  contractStart    DateTime
  contractEnd      DateTime
  vendor           vendors          @relation(fields: [vendorId], references: [id])
  afe              afes             @relation(fields: [afeId], references: [id])
}

model vendor_scorecards {
  id                 String   @id
  vendorId           String
  reviewPeriod       String
  qualityScore       Int
  timelinessScore    Int
  costAdherenceScore Int
  overallScore       Int
  reviewedByUserId   String
  notes              String?
  createdAt          DateTime @default(now())
  vendor             vendors  @relation(fields: [vendorId], references: [id])
  reviewedBy         users    @relation(fields: [reviewedByUserId], references: [id])

  @@unique([vendorId, reviewPeriod])
}

model spx_revenue_ledger {
  id             String               @id
  programId      String
  period         String
  tier           RevenueTier
  feeDescription String
  amountEtb      Decimal              @db.Decimal(14, 2)
  amountUsd      Decimal              @db.Decimal(14, 2)
  invoiceDate    DateTime
  paymentStatus  InvoicePaymentStatus @default(invoiced)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  program        programs             @relation(fields: [programId], references: [id])

  @@index([programId, period])
}

model coa_mapping {
  id            String @id
  sourceAccount String
  glAccount     String
  description   String @default("")
}

model gl_journal_exports {
  id                          String         @id
  programId                   String
  period                      String
  status                      GlExportStatus @default(pending)
  restrictedAccessTokenIssued Boolean        @default(false)
  storageKey                  String?
  createdAt                   DateTime       @default(now())
  program                     programs       @relation(fields: [programId], references: [id])
  lines                       gl_journal_export_lines[]
}

model gl_journal_export_lines {
  id        String              @id
  exportId  String
  date      DateTime
  account   String
  debitEtb  Decimal             @db.Decimal(14, 2)
  creditEtb Decimal             @db.Decimal(14, 2)
  memo      String
  export    gl_journal_exports  @relation(fields: [exportId], references: [id], onDelete: Cascade)
}

model schedule3_thresholds {
  programId      String
  band           AfeBand
  minValueUsd    Decimal  @db.Decimal(14, 2)
  maxValueUsd    Decimal? @db.Decimal(14, 2)
  spxAuthority   String
  silvaAuthority String
  effectiveYear  Int
  program        programs @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([programId, band])
}

model schedule4_insurance {
  id                 String   @id
  programId          String
  party              String
  coverageType       String
  minimumCoverageUsd Decimal  @db.Decimal(14, 2)
  beneficiary        String
  program            programs @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model accountability_matrix {
  programId           String
  operatingDiscipline String
  executeRole         String
  validateRole        String
  decideRole          String
  authorRole          String
  schedule3Ref        String
  program             programs @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([programId, operatingDiscipline])
}

model related_party_disclosures {
  id           String   @id
  programId    String
  party        String
  relationship String
  period       String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  program      programs @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model platform_config {
  programId                String   @id
  fxRateEtbPerUsd          Decimal  @db.Decimal(10, 4)
  enhancedGovernanceActive Boolean  @default(true)
  program                  programs @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model harvest_kpi_snapshots {
  id                          String   @id
  programId                   String
  year                        Int
  pickerProductivityCurrent   Decimal  @db.Decimal(10, 2)
  yieldTrendVsBaselinePercent Decimal  @db.Decimal(10, 2)
  createdAt                   DateTime @default(now())
  program                     programs @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, year])
}

model reports {
  id               String       @id
  programId        String
  type             ReportType
  period           String
  status           ReportStatus @default(draft)
  generatedAt      DateTime     @default(now())
  narrative        String?
  releasedAt       DateTime?
  releasedByUserId String?
  visibleToSilva   Boolean      @default(false)
  sections         Json?
  program          programs     @relation(fields: [programId], references: [id])
  releasedBy       users?       @relation(fields: [releasedByUserId], references: [id])

  @@index([programId, type, status])
}

model notifications {
  id              String   @id
  programId       String?
  triggerType     String
  entityType      String
  entityId        String
  recipientRole   String
  recipientUserId String?
  message         String
  sentAt          DateTime @default(now())
  acknowledged    Boolean  @default(false)
  program         programs? @relation(fields: [programId], references: [id])
  recipient       users?   @relation(fields: [recipientUserId], references: [id])

  @@index([programId])
}

model audit_log {
  id         String   @id
  programId  String?
  userId     String?
  entityType String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  timestamp  DateTime @default(now())
  program    programs? @relation(fields: [programId], references: [id])
  user       users?   @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([programId])
}

model attachments {
  id               String   @id
  entityType       String
  entityId         String
  fileName         String
  contentType      String
  sizeBytes        Int
  storageKey       String
  uploadedByUserId String
  createdAt        DateTime @default(now())
  uploadedBy       users    @relation(fields: [uploadedByUserId], references: [id])
}

model item_comments {
  id         String   @id
  programId  String?
  entityType String
  entityId   String
  userId     String
  content    String
  mentions   Json?
  createdAt  DateTime @default(now())

  user    users     @relation(fields: [userId], references: [id])
  program programs? @relation(fields: [programId], references: [id])

  @@index([entityType, entityId])
  @@index([programId])
}

model ifs_forms {
  id                 String       @id
  programId          String
  formType           IfsFormType
  title              String
  workOrderId        String?
  fieldTicketId      String?
  blockRef           String?
  weekNumber         Int?
  payload            Json
  status             IfsFormStatus @default(draft)
  submittedByUserId  String
  validatedByUserId  String?
  rejectionReason    String?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  program            programs     @relation(fields: [programId], references: [id])
  workOrder          work_orders? @relation(fields: [workOrderId], references: [id])
  fieldTicket        field_tickets? @relation(fields: [fieldTicketId], references: [id])
  submittedBy        users        @relation("IfsSubmitter", fields: [submittedByUserId], references: [id])
  validatedBy        users?       @relation("IfsValidator", fields: [validatedByUserId], references: [id])

  @@index([programId, formType, status])
  @@index([workOrderId])
}

model season_calendars {
  id              String               @id
  programId       String
  year            Int
  name            String
  status          SeasonCalendarStatus @default(draft)
  notes           String?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  program         programs             @relation(fields: [programId], references: [id])
  createdBy       users                @relation(fields: [createdByUserId], references: [id])
  windows         season_windows[]

  @@unique([programId, year, name])
  @@index([programId, year, status])
}

model season_windows {
  id                 String             @id
  calendarId         String
  programId          String
  operatingDiscipline String
  activity           String
  weekStart          Int
  weekEnd            Int
  status             SeasonWindowStatus @default(planned)
  linkedWorkOrderId  String?
  notes              String?
  issuedAt           DateTime?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  calendar           season_calendars   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  program            programs           @relation(fields: [programId], references: [id])
  linkedWorkOrder    work_orders?       @relation(fields: [linkedWorkOrderId], references: [id])

  @@index([programId, status])
  @@index([calendarId, weekStart])
}

model activity_catalog {
  id              String   @id
  programId       String
  afpLineId       String
  sectionCode     String
  sectionLabel    String
  sortOrder       Int
  nameEn          String
  nameAm          String?
  unit            String
  normMdPerUnit   Decimal? @db.Decimal(10, 6)
  normCostEtb     Decimal? @db.Decimal(14, 4)
  normWageEtb     Decimal? @db.Decimal(10, 2)
  normsPerMd      Decimal? @db.Decimal(10, 2)
  annualQuantity  Decimal? @db.Decimal(14, 2)
  annualMandays   Decimal? @db.Decimal(14, 2)
  annualCostEtb   Decimal? @db.Decimal(14, 2)
  scopeJson       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  program         programs          @relation(fields: [programId], references: [id])
  afpLine         afp_lines         @relation(fields: [afpLineId], references: [id])
  schedules       activity_schedule[]
  workOrders      work_orders[]
  fieldTickets    field_tickets[]

  @@index([programId, afpLineId])
  @@index([programId, sectionCode])
}

model activity_schedule {
  id                String   @id
  activityCatalogId String
  programId         String
  year              Int
  month             Int
  plannedQuantity   Decimal? @db.Decimal(14, 2)
  plannedMandays    Decimal? @db.Decimal(14, 2)
  plannedCostEtb    Decimal? @db.Decimal(14, 2)

  activityCatalog   activity_catalog @relation(fields: [activityCatalogId], references: [id], onDelete: Cascade)
  program           programs         @relation(fields: [programId], references: [id])

  @@unique([activityCatalogId, year, month])
  @@index([programId, year, month])
}

model afp_line_schedules {
  id              String   @id
  programId       String
  afpLineId       String
  year            Int
  month           Int
  plannedCostEtb  Decimal  @db.Decimal(14, 2)
  plannedCostUsd  Decimal? @db.Decimal(14, 2)

  program         programs  @relation(fields: [programId], references: [id])
  afpLine         afp_lines @relation(fields: [afpLineId], references: [id], onDelete: Cascade)

  @@unique([afpLineId, year, month])
  @@index([programId, year, month])
}

model work_plan_submissions {
  id                  String                   @id
  programId           String
  vendorId            String
  farmEstateId        String?
  farmName            String?
  totalAreaHa         Decimal?                 @db.Decimal(10, 2)
  budgetYearLabel     String
  budgetYearGc        Int
  status              WorkPlanSubmissionStatus @default(draft)
  fxEtbPerUsd         Decimal                  @db.Decimal(10, 2)
  parsedJson          Json?
  sourceAttachmentId  String?
  submittedAt         DateTime?
  submittedByUserId   String?
  reviewedAt          DateTime?
  reviewedByUserId    String?
  reviewNotes         String?
  promotedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  program             programs                 @relation(fields: [programId], references: [id])
  vendor              vendors                  @relation(fields: [vendorId], references: [id])
  farmEstate          farm_estates?            @relation(fields: [farmEstateId], references: [id])
  submittedBy         users?                   @relation("WorkPlanSubmitter", fields: [submittedByUserId], references: [id])
  reviewedBy          users?                   @relation("WorkPlanReviewer", fields: [reviewedByUserId], references: [id])
  afpLines            afp_lines[]

  @@index([programId, status])
  @@index([vendorId, budgetYearGc])
  @@index([farmEstateId])
}

model farm_estates {
  id                  String           @id
  programId           String
  ownerOrganizationId String?
  name                String
  totalAreaHa         Decimal?         @db.Decimal(10, 2)
  location            String?
  notes               String?
  status              FarmEstateStatus @default(active)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  program             programs                  @relation(fields: [programId], references: [id])
  ownerOrganization   organizations?            @relation("FarmEstateOwner", fields: [ownerOrganizationId], references: [id])
  vendorMaps          farm_estate_vendors[]
  blocks              farm_blocks[]
  workPlanSubmissions work_plan_submissions[]

  @@unique([programId, name])
  @@index([programId, status])
  @@index([ownerOrganizationId])
}

model farm_estate_vendors {
  id           String   @id
  farmEstateId String
  vendorId     String
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())

  farmEstate farm_estates @relation(fields: [farmEstateId], references: [id], onDelete: Cascade)
  vendor     vendors      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([farmEstateId, vendorId])
  @@index([vendorId])
}

model farm_blocks {
  id           String   @id
  programId    String
  farmEstateId String?
  code         String
  label        String?
  areaHa       Decimal? @db.Decimal(10, 2)
  treeCount    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program     programs      @relation(fields: [programId], references: [id])
  farmEstate  farm_estates? @relation(fields: [farmEstateId], references: [id], onDelete: SetNull)
  assignments work_order_block_assignments[]

  @@unique([programId, farmEstateId, code])
  @@index([programId])
  @@index([farmEstateId])
}

model work_order_block_assignments {
  id          String      @id
  workOrderId String
  blockId     String
  userId      String?
  roleOnBlock String      @default("manager")
  createdAt   DateTime    @default(now())

  workOrder   work_orders @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  block       farm_blocks @relation(fields: [blockId], references: [id])
  user        users?      @relation("BlockManager", fields: [userId], references: [id])

  @@unique([workOrderId, blockId])
  @@index([blockId])
}

model id_sequences {
  name      String @id
  lastValue Int    @default(0)
}
