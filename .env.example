NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://coffee:coffee@localhost:5432/coffee_field_os?schema=public

JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_GL_EXPORT_SECRET=change-me-gl-export-secret
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

REDIS_URL=redis://localhost:6379

# Local MinIO:
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio12345
#
# Supabase Storage (S3 protocol):
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-3
S3_BUCKET="Silva Proj Bucket"
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# Cropfort demo: skip TOTP step on login (dev/test only)
CROPFORT_OTP_ON_LOGIN=false

# Public frontend URL for invite/activation links in emails (no trailing slash)
# Production: set to your hosted app URL, e.g. https://farm.spxafrica.com
APP_BASE_URL=http://localhost:3000

# Browser origins allowed to call this API (comma-separated, no trailing slash).
# Production example: CORS_ORIGINS=https://farm.spxafrica.com
# APP_BASE_URL is also included automatically when set.
CORS_ORIGINS=

# Email — choose provider: smtp (nodemailer), resend, or auto (default: try Resend then SMTP)
MAIL_PROVIDER=smtp
MAIL_FROM=SPX Secure Deal Room <your-email@gmail.com>

# Gmail example (use an App Password, not your normal password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Resend (optional — comment out or remove RESEND_API_KEY when using SMTP)
# RESEND_API_KEY=
